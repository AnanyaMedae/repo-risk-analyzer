{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Repo Risk Analyzer",
      "type": "debugpy",
      "request": "launch",
      "module": "app.main",
      "envFile": "${workspaceFolder}/.env",
      "justMyCode": true
    },
    {
      "name": "Run unit tests",
      "type": "debugpy",
      "request": "launch",
      "module": "unittest",
      "args": ["discover", "-s", "tests", "-v"]
    }
  ]
}
